{
  "name": "@conorbronsdon/yt-analytics-mcp",
  "version": "0.1.0",
  "description": "MCP server for the YouTube Analytics API — owner-side channel, video and playlist analytics for AI agents: watch time, traffic sources, audience retention, podcast-series metrics, and episode-over-episode comparison. Read-only.",
  "type": "module",
  "bin": {
    "yt-analytics-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube-analytics",
    "youtube",
    "podcast-analytics",
    "playlist-analytics",
    "audience-retention",
    "watch-time",
    "traffic-sources",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "author": "Conor Bronsdon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorbronsdon/yt-analytics-mcp.git"
  },
  "homepage": "https://github.com/conorbronsdon/yt-analytics-mcp#readme",
  "bugs": {
    "url": "https://github.com/conorbronsdon/yt-analytics-mcp/issues"
  },
  "mcpName": "io.github.conorbronsdon/yt-analytics-mcp"
}
